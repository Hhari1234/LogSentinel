# =============================================================================
# Build stage: Maven + Eclipse Temurin JDK 17
# =============================================================================
FROM maven:3.9-eclipse-temurin-17 AS build

WORKDIR /workspace

# Copy Maven project files
COPY pom.xml .
COPY src ./src

# Package the application (skip tests here; tests run separately in CI)
RUN mvn clean package -DskipTests

# =============================================================================
# Runtime stage: Eclipse Temurin Java 17 JRE
# =============================================================================
FROM eclipse-temurin:17-jre

WORKDIR /app

# Copy the packaged JAR from the build stage
COPY --from=build /workspace/target/logsentinel-1.0.0.jar app.jar

# Expose the application port (Vercel sets PORT at runtime)
EXPOSE 8080

# Environment variable for the port (Vercel provides PORT automatically)
ENV PORT=8080

# Start LogSentinel dashboard
ENTRYPOINT ["java", "-jar", "app.jar", "--dashboard"]
